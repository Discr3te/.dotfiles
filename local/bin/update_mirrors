#!/usr/bin/env bash
country=US
protocol=https

sudo pacman -S --noconfirm --needed pacman-contrib || exit $?

mirrorlist_url="https://archlinux.org/mirrorlist/?country=$country&protocol=$protocol&use_mirror_status=on"
pacmand_dir="/etc/pacman.d"
mirrorlist="$pacmand_dir/mirrorlist"
new_mirrorlist="$pacmand_dir/mirrorlist.new"
backup_mirrorlist="$pacmand_dir/mirrorlist.bk"

echo "Downloading new mirrorlist"
sudo curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors "$mirrorlist_url" -o "$new_mirrorlist" || exit $?
sudo sed -i 's/^# *Server/Server/' $new_mirrorlist

if [ -f "$backup_mirrorlist" ]; then
  sudo rm $backup_mirrorlist
fi

if [ -f "$mirrorlist" ]; then
  sudo mv $mirrorlist $backup_mirrorlist
fi

echo "Ranking mirrorlist, this will take a few minutes..."
sudo rankmirrors -n 5 $new_mirrorlist | sudo tee $mirrorlist >/dev/null

echo "Finished ranking mirrorlist."
sudo rm $new_mirrorlist
