#!/usr/bin/env bash

# Key type
KT_AUTH=auth
KT_SIGNING=signing

SSH_DIR="$HOME"/.ssh
ALLOWED_SIGNERS_FILE="$SSH_DIR/allowed_signers"
SSH_CONFIG_FILE="$SSH_DIR/config"

# for bash select
COLUMNS=1

create_keys() {
  local key_type=$1
  local user_email
  user_email=$(git config user.email)
  local keygen_opts=(
    -t ed25519-sk
    -O resident
    -O verify-required
    -O application=ssh:git_"$key_type"
    -C "Git $key_type key $user_email"
    -f "$SSH_DIR/id_ed25519_sk_git_$key_type"
  )
  echo "Creating git $key_type key"
  ssh-keygen "${keygen_opts[@]}"
}

append_allowed_signers() {
  local user_email
  local signing_key
  user_email=$(git config user.email)

  IFS= read -r signing_key <"$SSH_DIR/id_ed25519_sk_git_$KT_SIGNING.pub"

  printf "%s" "Creating allowed signers file..."
  echo "$user_email namespaces=\"git\" $signing_key" >>"$ALLOWED_SIGNERS_FILE"
}

append_config_file() {
  printf "%s" "Creating config file..."
  cat >>"$SSH_CONFIG_FILE" <<EOF
  Host github.com
  IdentityFile ~/.ssh/id_ed25519_sk_git_$KT_AUTH
  IdentitiesOnly yes
EOF
}

select_choice() {
  local options=(
    "Create new keys"
    "Download existing keys from your hardware key"
    "Quit"
  )
  local new_key_opts=(
    "Create a new git authentication key"
    "Create a new git signing key"
    "Create both a new git signing key and authentication key"
    "Go Back"
    "Quit"
  )

  clear
  PS3="What would you like to do: "
  select choice in "${options[@]}"; do
    case $choice in
    "Create new keys")
      clear
      PS3="What would you like to do: "
      select choice in "${new_key_opts[@]}"; do
        case $choice in
        "Create a new git authentication key")
          clear
          create_keys $KT_AUTH
          clear
          printf "%s\n" "Copy this $KT_AUTH key into your Git-based platform:"
          cat "$SSH_DIR/id_ed25519_sk_git_$KT_AUTH.pub"
          echo ""
          read -rp "Press ENTER to continue"
          select_choice
          ;;
        "Create a new git signing key")
          clear
          create_keys $KT_SIGNING
          append_allowed_signers
          clear
          printf "%s\n" "Copy this $KT_SIGNING key into your Git-based platform:"
          cat "$SSH_DIR/id_ed25519_sk_git_$KT_SIGNING.pub"
          echo ""
          read -rp "Press ENTER to continue"
          select_choice
          ;;
        "Create both a new git signing key and authentication key")
          clear
          create_keys $KT_AUTH
          echo ""
          clear
          create_keys $KT_SIGNING
          append_allowed_signers
          clear
          printf "%s\n" "Copy this $KT_AUTH key into your Git-based platform:"
          cat "$SSH_DIR/id_ed25519_sk_git_$KT_AUTH.pub"
          echo ""
          printf "%s\n" "Copy this $KT_SIGNING key into your Git-based platform:"
          cat "$SSH_DIR/id_ed25519_sk_git_$KT_SIGNING.pub"
          echo ""
          read -rp "Press ENTER to continue"
          select_choice
          ;;
        "Go Back")
          select_choice
          ;;
        "Quit")
          exit
          ;;
        *)
          echo "Invalid option $REPLY"
          ;;
        esac
      done
      ;;
    "Download existing keys from your hardware key")
      pushd "$SSH_DIR" || exit
      ssh-keygen -K
      mv "$SSH_DIR/id_ed25519_sk_rk_git_$KT_SIGNING.pub" "$SSH_DIR/id_ed25519_sk_git_$KT_SIGNING.pub"
      mv "$SSH_DIR/id_ed25519_sk_rk_git_$KT_SIGNING" "$SSH_DIR/id_ed25519_sk_git_$KT_SIGNING"
      mv "$SSH_DIR/id_ed25519_sk_rk_git_$KT_AUTH.pub" "$SSH_DIR/id_ed25519_sk_git_$KT_AUTH.pub"
      mv "$SSH_DIR/id_ed25519_sk_rk_git_$KT_AUTH" "$SSH_DIR/id_ed25519_sk_git_$KT_AUTH"
      append_allowed_signers
      append_config_file
      popd || exit
      clear
      printf "%s\n" "Your existing keys have successfully been downloaded to: $SSH_DIR."
      read -rp "Press ENTER to continue"
      select_choice
      ;;
    Quit)
      exit
      ;;
    *)
      echo "Invalid option $REPLY"
      ;;
    esac
  done
}

sudo pacman -Syu --noconfirm --needed git openssh
mkdir -p "$SSH_DIR"
select_choice
